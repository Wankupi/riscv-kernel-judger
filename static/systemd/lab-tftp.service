[Unit]
Description=RISCV Lab TFTP Boot Server
After=network.target

PartOf=lab-runner.service

[Service]
Type=simple
User=wkp
Group=wkp
ExecStart=tftpy_server -q -r /home/wkp/codes/riscv-kernel-judger/static/boot
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
