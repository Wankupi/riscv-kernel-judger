[Unit]
Description=Lab 0 Python TFTP Server

[Service]
User=wkp
Group=wkp
ExecStart=tftpy_server -q -r /home/wkp/codes/riscv-kernel-judger/static/boot
WorkingDirectory=/home/wkp/codes/riscv-kernel-judger/static/boot
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
